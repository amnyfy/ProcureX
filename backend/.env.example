# ProcureX Backend Environment Configuration Template

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/procurex

# JWT Security Configuration
SECRET_KEY=your_secure_jwt_secret_key_here
ALGORITHM=HS256

# Allowed Frontend URLs for CORS (comma-separated)
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
